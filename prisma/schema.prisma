// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HOST
  PLAYER
}

enum RoomStatus {
  LOBBY
  ACTIVE
  REVEAL
  ENDED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model College {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique @db.VarChar(10)
  users     User[]
  rooms     Room[]
  createdAt DateTime @default(now())
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           Role          @default(PLAYER)
  collegeId      String
  college        College       @relation(fields: [collegeId], references: [id])
  
  // Relations
  roomsCreated   Room[]        @relation("HostRooms")
  questionSets   QuestionSet[] // 👈 Added: Host ke banaye hue question sets
  roomPlayers    RoomPlayer[]
  answers        Answer[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model QuestionSet {
  id          String     @id @default(cuid())
  name        String
  description String?
  hostId      String
  host        User       @relation(fields: [hostId], references: [id]) // 👈 Added proper relation
  questions   Question[]
  rooms       Room[]     // 👈 Fixed: Capital 'R' se lowercase 'r' (Best Practice)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
}

model Question {
  id            String      @id @default(cuid())
  text          String      @db.Text
  topic         String
  difficulty    Difficulty  @default(MEDIUM)
  imageUrl      String?
  tableData     Json?
  timeLimit     Int
  questionSetId String
  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  options       Option[]
  createdAt     DateTime    @default(now())
}

model Option {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Room {
  id            String       @id @default(cuid())
  code          String       @unique @db.VarChar(6)
  hostId        String
  host          User         @relation("HostRooms", fields: [hostId], references: [id])
  collegeId     String
  college       College      @relation(fields: [collegeId], references: [id])
  questionSetId String
  questionSet   QuestionSet  @relation(fields: [questionSetId], references: [id])
  status        RoomStatus   @default(LOBBY)
  settings      Json
  players       RoomPlayer[]
  answers       Answer[]
  createdAt     DateTime     @default(now())
}

model RoomPlayer {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestName String?
  score     Int      @default(0)
  isReady   Boolean  @default(false)
  joinedAt  DateTime @default(now())

  @@unique([roomId, userId])
  @@unique([roomId, guestName])
}

model Answer {
  id               String   @id @default(cuid())
  roomId           String
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  responseTimeMs   Int
  submittedAt      DateTime @default(now())
}